  "bin": {
    "copass": "./index.js"
  },
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "index.js",
    "lib/",
    "agents/"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node --test"
  },
  "keywords": ["ai", "agent", "handoff", "context", "relay", "claude-code", "codex", "copilot", "antigravity", "cline", "gemini-cli", "cursor", "opencode"],
